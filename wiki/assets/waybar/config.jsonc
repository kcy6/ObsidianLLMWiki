{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "wireplumber",
    "battery",
    "tray"
  ],
  "niri/workspaces": {
    "format": "{index}"
  },
  "niri/window": {
    "format": "{}",
    "max-length": 26
  },
  "clock": {
    "format": "{:%m月%d日  %H:%M}",
    "format-alt": "{:%Y-%m-%d  %A}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "有线",
    "format-disconnected": "离线",
    "tooltip-format": "{ifname}  {ipaddr}",
    "tooltip-format-wifi": "{essid}  {ipaddr}",
    "interval": 5
  },
  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "静音",
    "scroll-step": 2,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "充电 {capacity}%",
    "format-plugged": "电源 {capacity}%",
    "tooltip-format": "{timeTo} · {capacity}%",
    "interval": 30
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
