# Obsidian：当前设备正在打开的窗口和标签页
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json

# Obsidian：缓存与仓库回收站
/.obsidian/cache/
/.obsidian/.cache/
/.trash/

# Quiet Outline：逐笔记展开、光标及滚动状态仅保留在本机
/.obsidian/plugins/obsidian-quiet-outline/markdown-states.json

# 同步插件程序、data.json 设置、主题、快捷键、
# 已保存的工作区 workspaces.json 和恢复功能设置 file-recovery.json

# Python：解释器缓存和根目录本地虚拟环境
__pycache__/
*.py[cod]
/.venv/

# 操作系统自动生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 根目录的本地环境变量；示例文件可以提交
/.env
/.env.*
!/.env.example
!/.env.sample

# 笔记、附件、Canvas、Wiki、Obsidian 使用配置和子模块引用均保留
# 本文件只排除路径，不会过滤其他文件正文或 Git 提交身份中的隐私信息
